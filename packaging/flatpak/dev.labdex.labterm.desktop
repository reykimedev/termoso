[Desktop Entry]
Name=Labterm
Comment=SSH, SFTP and terminal client with an encrypted vault
Exec=labterm %U
Icon=dev.labdex.labterm
Terminal=false
Type=Application
Categories=Network;RemoteAccess;System;TerminalEmulator;
Keywords=ssh;sftp;terminal;mosh;telnet;serial;
MimeType=x-scheme-handler/ssh;x-scheme-handler/labterm;x-scheme-handler/termoso;
StartupWMClass=labterm
