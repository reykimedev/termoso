# syntax=docker/dockerfile:1.7
#
# labterm-bridge: the API Bridge that runs in *your* infrastructure. It holds
# the bridge private key and the vault keys, encrypts hosts/groups/credentials
# locally and pushes only ciphertext to the Labterm server.

FROM rust:1-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY apps/desktop/src-tauri ./apps/desktop/src-tauri
# Same cache mounts as the server build (deploy/Dockerfile): built after it in one builder (CI
# does), the dependencies they share are not compiled again.
RUN --mount=type=cache,id=cargo-registry-server,target=/usr/local/cargo/registry \
    --mount=type=cache,id=target-server,target=/src/target \
    cargo build --release --locked -p labterm-bridge \
    && cp target/release/labterm-bridge /labterm-bridge

FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=build /labterm-bridge /usr/local/bin/labterm-bridge
ENV LABTERM_BRIDGE_CREDENTIALS=/etc/labterm/bridge.json \
    LABTERM_BRIDGE_LISTEN=0.0.0.0:8080
EXPOSE 8080
USER nonroot
ENTRYPOINT ["/usr/local/bin/labterm-bridge"]
