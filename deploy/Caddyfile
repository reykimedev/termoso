# Reverse proxy for the `proxy` profile of docker-compose.yml.
# Certificates come from Let's Encrypt automatically; both hostnames must
# point at this machine. Caddy sets X-Forwarded-For, which the API honours
# because LABTERM_TRUST_PROXY=true in the stack.

{
	email {$ACME_EMAIL}
}

# API + web cabinet + WebSocket, one origin. With the landing on its own
# domain (LABTERM_LANDING_URL) list both, comma-separated:
#   LABTERM_DOMAIN=app.example.com, example.com
# The server routes by Host; the same goes for LABTERM_SSHID_URL.
{$LABTERM_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8080
}

# Pre-signed session-log uploads/downloads (LABTERM_S3__PUBLIC_ENDPOINT).
{$LABTERM_S3_DOMAIN} {
	reverse_proxy rustfs:9000
}
