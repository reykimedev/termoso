# ── required ────────────────────────────────────────────────────────────────
# 32 random bytes, base64. Encrypts server-side secrets at rest.
# Losing it makes the database unusable. Generate: openssl rand -base64 32
LABTERM_MASTER_KEY=

# Public URL of the server. The image serves both the API (/api/v1) and the web
# cabinet (/) on this origin.
LABTERM_PUBLIC_URL=https://labterm.example.com
# Origin of the web cabinet (links in e-mails, redirects from the landing).
# Defaults to LABTERM_PUBLIC_URL; set it only when the cabinet is hosted elsewhere.
#LABTERM_WEB_URL=https://app.labterm.example.com

# Landing page on `/`. Three layouts:
#   1. default — landing and cabinet share LABTERM_PUBLIC_URL (`/` = landing).
#   2. LABTERM_LANDING=false — no landing; `/` goes straight to /login.
#   3. LABTERM_LANDING_URL=https://labterm.example.com with
#      LABTERM_PUBLIC_URL=LABTERM_WEB_URL=https://app.labterm.example.com —
#      the landing on the apex domain, cabinet + API on the subdomain. Point
#      both names at this server; on the landing host only `/` and the static
#      files are served, every other path redirects to the cabinet.
#LABTERM_LANDING=true
#LABTERM_LANDING_URL=https://labterm.example.com
# Optional dedicated origin for SSH ID: point its DNS at the same server and
# handles are served at the root (https://sshid.labterm.example.com/<handle>,
# /<handle>/RSA, /<handle>/all) with no API or cabinet on that host.
# Unset = https://labterm.example.com/sshid/<handle> (always available).
#LABTERM_SSHID_URL=https://sshid.labterm.example.com

# ── stack (docker-compose.yml / quadlet) ────────────────────────────────────
POSTGRES_PASSWORD=change-me
RUSTFS_ACCESS_KEY=labterm
RUSTFS_SECRET_KEY=change-me-too
#S3_BUCKET=labterm-logs

# Public origin clients use for pre-signed session-log uploads/downloads.
# Your reverse proxy forwards it to rustfs:9000. Required for session logs.
LABTERM_S3__PUBLIC_ENDPOINT=https://s3.labterm.example.com

# Alternative to S3: keep the (client-encrypted) session logs on the server's
# disk. Mount a volume at this path; clients download through short-lived
# tokens on /api/v1/logs/blob. Takes precedence over LABTERM_S3__* when set.
#LABTERM_LOGS_DIR=/var/lib/labterm/logs

# Image tag (a release like 0.2.0, or latest) and where published ports bind.
# 127.0.0.1 keeps everything private until a reverse proxy is in front; use
# 0.0.0.0 only if the proxy runs on another machine.
LABTERM_VERSION=latest
LABTERM_LISTEN=127.0.0.1
LABTERM_PORT=8080
#RUSTFS_PORT=9000
#RUSTFS_CONSOLE_PORT=9001

# `--profile proxy`: Caddy with automatic TLS. Both names must resolve to this
# host; LABTERM_S3_DOMAIN must equal the host in LABTERM_S3__PUBLIC_ENDPOINT.
# LABTERM_DOMAIN takes a comma-separated list when the landing (or SSH ID)
# has its own hostname, e.g. `app.labterm.example.com, labterm.example.com`.
#LABTERM_DOMAIN=labterm.example.com
#LABTERM_S3_DOMAIN=s3.labterm.example.com
#ACME_EMAIL=you@example.com

# `--profile bridge`: API Bridge. Credentials file from the cabinet
# (Account → API Bridge) and a shared secret callers must present.
#LABTERM_BRIDGE_CREDENTIALS_FILE=./bridge.json
#LABTERM_BRIDGE_API_KEY=
#LABTERM_BRIDGE_PORT=8081
#LABTERM_BRIDGE_SYNC_INTERVAL=60

# ── recommended ─────────────────────────────────────────────────────────────
# Comma-separated e-mails that become administrators on sign-up / login.
LABTERM_ADMIN_EMAILS=you@example.com
LABTERM_SERVER_NAME=Labterm
# Extra comma-separated browser origins allowed to call the API. Not needed when
# the cabinet is served by the server itself.
#LABTERM_CORS_ORIGINS=https://app.labterm.example.com

# SMTP (e-mail verification, device approval, e-mail MFA). Omit to run without e-mail.
LABTERM_SMTP__HOST=smtp.example.com
LABTERM_SMTP__PORT=587
LABTERM_SMTP__USERNAME=
LABTERM_SMTP__PASSWORD=
LABTERM_SMTP__SECURITY=starttls
LABTERM_SMTP__FROM=Labterm <no-reply@labterm.example.com>

# WebAuthn / passkeys (optional).
LABTERM_WEBAUTHN__RP_ID=labterm.example.com
LABTERM_WEBAUTHN__ORIGINS=https://labterm.example.com,tauri://localhost,http://tauri.localhost

# ── optional ────────────────────────────────────────────────────────────────
# Android App Links: lets the Labterm Android app open this server's
# https://…/invite/<token> and /join/<id> links directly. Comma-separated
# <package>=<SHA-256 signing-certificate fingerprint>; served as
# /.well-known/assetlinks.json. Fingerprint: keytool -list -v … | grep SHA256
#LABTERM_ANDROID_APP_LINKS=dev.labdex.labterm=AA:BB:CC:…

# SSO (OIDC). Presets: google, microsoft, github. Any other slug needs ISSUER.
#LABTERM_SSO__GOOGLE__CLIENT_ID=
#LABTERM_SSO__GOOGLE__CLIENT_SECRET=
#LABTERM_SSO__GITHUB__CLIENT_ID=
#LABTERM_SSO__GITHUB__CLIENT_SECRET=
#LABTERM_SSO__COMPANY__NAME=Company SSO
#LABTERM_SSO__COMPANY__ISSUER=https://login.example.com/realms/main
#LABTERM_SSO__COMPANY__CLIENT_ID=
#LABTERM_SSO__COMPANY__CLIENT_SECRET=
#LABTERM_SSO__COMPANY__ALLOWED_DOMAINS=example.com
# SSO (SAML 2.0). Register the SP at <LABTERM_PUBLIC_URL>/api/v1/auth/sso/corp/saml/metadata
# with your IdP; the ACS is <LABTERM_PUBLIC_URL>/api/v1/auth/sso/saml/acs (HTTP-POST).
# SAML_METADATA is a URL, a file path or inline XML. The SP certificate/key
# (PEM or paths) enable signed AuthnRequests and encrypted assertions;
# SAML_SIGN_REQUESTS defaults to what the IdP metadata asks for. Email/name
# attributes default to mail/email/OID/WS-Fed claims or an email NameID.
#LABTERM_SSO__CORP__NAME=Corp SAML
#LABTERM_SSO__CORP__KIND=saml
#LABTERM_SSO__CORP__SAML_METADATA=https://idp.example.com/metadata
#LABTERM_SSO__CORP__SAML_IDP_ENTITY_ID=
#LABTERM_SSO__CORP__SAML_SP_CERTIFICATE=/run/secrets/saml-sp.crt
#LABTERM_SSO__CORP__SAML_SP_PRIVATE_KEY=/run/secrets/saml-sp.key
#LABTERM_SSO__CORP__SAML_SIGN_REQUESTS=
#LABTERM_SSO__CORP__SAML_ALLOW_SHA1=false
#LABTERM_SSO__CORP__SAML_EMAIL_ATTRIBUTE=
#LABTERM_SSO__CORP__SAML_NAME_ATTRIBUTE=
#LABTERM_SSO__CORP__SAML_CLOCK_SKEW_SECS=120
#LABTERM_SSO__CORP__ALLOWED_DOMAINS=example.com

# AI command suggestions (optional; unset = feature absent). Users still have
# to opt in per account. Only the typed request + OS/shell label is sent; the
# key, prompts and answers are never logged. Defaults target Chutes' TEE model
# (confidential compute — not end-to-end encryption). Any OpenAI-compatible
# endpoint works: set URL/MODEL and CONFIDENTIAL=false for a plain one.
#LABTERM_AI__API_KEY=
#LABTERM_AI__URL=https://llm.chutes.ai/v1
#LABTERM_AI__MODEL=GLM-4.7-Flash-NVFP4-TEE
#LABTERM_AI__PROVIDER=Chutes
#LABTERM_AI__CONFIDENTIAL=true
#LABTERM_AI__DAILY_QUOTA=50
#LABTERM_AI__MAX_PROMPT_CHARS=500
#LABTERM_AI__TIMEOUT_SECS=30

# Operator-only Prometheus metrics on a separate private listener. Off by default.
#LABTERM_METRICS__ENABLED=true
#LABTERM_METRICS__BIND=127.0.0.1:9090

LABTERM_LOG=info,sqlx=warn
LABTERM_LOG_FORMAT=json
# Swagger UI at /api/docs and the OpenAPI document at /api/openapi.json.
LABTERM_SWAGGER_UI=false
# Documentation at /docs (part of the web cabinet bundle). LABTERM_DOCS=false hides
# it; LABTERM_DOCS_URL gives it its own origin (https://docs.example.com) — the
# landing and cabinet then redirect /docs there. Needs LABTERM_WEB_DIR.
#LABTERM_DOCS=true
#LABTERM_DOCS_URL=
# API bridges (Account → API Bridge, bridge tokens). Default true; the hosted
# cloud runs with false, which hides the page and rejects bridge tokens.
#LABTERM_BRIDGES=true
# PostgreSQL pool size per API replica.
#LABTERM_DATABASE_MAX_CONNECTIONS=20
# Prefix for all Redis keys/channels (only needed if deployments share one Redis).
#LABTERM_REDIS_PREFIX=labterm:
# Waiting period (seconds) of the "Start over" account reset. Default 24 h.
#LABTERM_START_OVER_DELAY_SECS=86400
