# Labterm server: REST + WebSocket API under /api/v1 and the web cabinet on /.
# Stateless; runs database migrations on start. Put a TLS-terminating reverse
# proxy in front of 127.0.0.1:8080 (LABTERM_TRUST_PROXY=true is set in
# stack.env).
#
# Configuration: /etc/labterm/env (server settings, same file as the Compose
# stack) then /etc/labterm/stack.env (in-stack addresses and credentials).
[Unit]
Description=Labterm server
Requires=labterm-postgres.service labterm-redis.service labterm-rustfs.service
After=labterm-postgres.service labterm-redis.service labterm-rustfs.service

[Container]
ContainerName=labterm-api
Image=ghcr.io/reykimedev/labterm-server:latest
# Uncomment to let `podman auto-update` pull new images and restart the unit.
#AutoUpdate=registry
Network=labterm.network
EnvironmentFile=/etc/labterm/env
EnvironmentFile=/etc/labterm/stack.env
PublishPort=127.0.0.1:8080:8080
ReadOnly=true
Tmpfs=/tmp
NoNewPrivileges=true
HealthCmd=/usr/local/bin/labterm-server --healthcheck
HealthInterval=15s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=30s
Notify=healthy

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
