# In-stack addresses and credentials for the Quadlet units. Install as
# /etc/labterm/stack.env (mode 0600). The server settings themselves live in
# /etc/labterm/env — a filled-in copy of deploy/.env.example.
#
# Change the two passwords in BOTH places they appear.

POSTGRES_USER=labterm
POSTGRES_DB=labterm
POSTGRES_PASSWORD=change-me

RUSTFS_ACCESS_KEY=labterm
RUSTFS_SECRET_KEY=change-me-too

LABTERM_BIND=0.0.0.0:8080
LABTERM_DATABASE_URL=postgres://labterm:change-me@labterm-postgres:5432/labterm
LABTERM_REDIS_URL=redis://labterm-redis:6379
LABTERM_S3__ENDPOINT=http://labterm-rustfs:9000
LABTERM_S3__BUCKET=labterm-logs
LABTERM_S3__ACCESS_KEY=labterm
LABTERM_S3__SECRET_KEY=change-me-too
LABTERM_S3__REGION=us-east-1
LABTERM_TRUST_PROXY=true
